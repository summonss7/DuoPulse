      {
        "ext": [
          "pdf"
        ],
        "name": "DuoPulse PDF",
        "description": "PDF-документ",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ]
  },
  "app": {
    "withGlobalTauri": true,
