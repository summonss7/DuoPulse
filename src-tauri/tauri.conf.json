{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuoPulse",
  "version": "0.1.44",
  "identifier": "dev.duopulse.spike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "DuoPulse PDF",
        "description": "PDF-документ",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1MzhGMTE1QjdBMkVBM0QKUldROTZxSzNGZkU0SmZQUWk5S3ROeUJVZklzeGoxUmJpa0dLNFRBbkNDNmVsSDJyYzUyWjN5ZlEK",
      "endpoints": [
        "https://summonss7.github.io/duopulse-updates/stable/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      },
      "dangerousInsecureTransportProtocol": true
    }
  }
}