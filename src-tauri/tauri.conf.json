{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuoPulse",
  "version": "0.1.0",
  "identifier": "dev.duopulse.spike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DuoPulse — M0 spike (Tauri 2 + WebView2)",
        "width": 1360,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
