      "handler": "bridge_version",
      "params": null,
      "result": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "bridge.version: версия контракта живого приложения (диагностика, e2e).",
        "properties": {
          "version": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "version"
        ],
        "title": "BridgeVersionResult",
        "type": "object"
      }
    },
    "history.search": {
      "handler": "history_search",
      "params": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "history.search: подсказки omnibox — полнотекстовый поиск по истории и закладкам (FTS5, задача 1.3; хранилище — src/history/, пока временные данные, полная интеграция — задача 1.4).",
        "properties": {
          "limit": {
            "default": 8,
            "description": "Максимум подсказок в ответе (по умолчанию 8, диапазон 1–20).",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "HistorySearchParams",
        "type": "object"
      },
      "result": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "definitions": {
          "HistoryHit": {
            "description": "Одна подсказка omnibox: источник, адрес и заголовок страницы.",
            "properties": {
              "source": {
                "$ref": "#/definitions/HistorySource"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "title",
              "url"
            ],
            "type": "object"
          },
          "HistorySource": {
            "description": "Откуда подсказка: посещение из истории или закладка.",
            "enum": [
              "history",
              "bookmark"
            ],
            "type": "string"
          }
        },
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/definitions/HistoryHit"
            },
            "type": "array"
          }
        },
        "required": [
          "hits"
        ],
        "title": "HistorySearchResult",
        "type": "object"
      }
    },
